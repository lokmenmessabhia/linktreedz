# Copy this file to .env and fill in real values. Never commit .env.
# The application loads this file automatically from the project root.

# Database
DB_HOST=localhost
DB_NAME=lokpixtreee
DB_USER=root
DB_PASS=

# Public URL (optional; auto-detected when empty)
# BASE_URL=https://example.com
SITE_NAME=Linky Dz
SITE_SLUG=linky-dz

# Footer branding and social links (optional; hidden when empty)
STUDIO_NAME=
STUDIO_URL=
SOCIAL_INSTAGRAM_URL=

# Locale
# Used for phone placeholders and WhatsApp links (e.g. 213 for Algeria)
PHONE_COUNTRY_CODE=

# Optional third-party endpoints (leave empty to disable the feature)
QR_API_URL=
IP_API_URL=

# Python interpreter for CMYK PDF conversion
PYTHON_BIN=python

# Admin recovery account used by reset-admin.php
RECOVERY_USER=admin
RECOVERY_EMAIL=admin@example.com
RECOVERY_PASS=
# Required by reset-admin.php; choose a long random value
RECOVERY_KEY=

# Telegram order notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
