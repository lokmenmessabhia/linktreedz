# Copy this file to .env and fill in real values. Never commit .env.
# The application loads this file automatically from the project root.

# Database
DB_HOST=localhost
DB_NAME=lokpixtreee
DB_USER=root
DB_PASS=

# Public URL (optional; auto-detected when empty)
# BASE_URL=https://example.com
SITE_NAME=Linky Dz

# Admin recovery account used by reset-admin.php
RECOVERY_USER=admin
RECOVERY_EMAIL=admin@example.com
RECOVERY_PASS=
# Required by reset-admin.php; choose a long random value
RECOVERY_KEY=

# Telegram order notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
